# Auto detect text files and perform LF normalization
* text=auto

# Explicit text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.csv text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
*.wasm binary
*.gz binary
*.pptx binary
*.pdf binary
